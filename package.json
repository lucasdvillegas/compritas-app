{
  "name": "compritas-app",
  "version": "1.0.0",
  "description": "Listas de compras compartidas, precios por kilo o unidad y estadísticas de gastos.",
  "productName": "Compritapp",
  "author": "lucasdvillegas <lucasdvillegas@hotmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.35.2",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.0.6",
    "yup": "^1.7.1",
    "yup-es": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.3",
